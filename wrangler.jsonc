{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bored_games",
  "compatibility_date": "2026-09-11",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /bored_games off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what src/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/bored_games", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/bored_games/*", "zone_name": "csiesheep.com" }
  ],
  // Only public/ is uploaded as static assets; src/ is bundled into the Worker.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // One room = one Durable Object, named by the four-letter room code
  // (src/index.js: `idFromName(code)`). The rules live in the pure core
  // src/room-core.js; src/room.js is only the wiring.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // First migration for this Worker. SQLite-backed storage is the only option
  // for new classes; the tag is what Cloudflare remembers, so `v1` never
  // changes meaning — a later class gets `v2`, it does not edit this one.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
